<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.codeboy.mvc.model.dao.IncorrectNoteDao">
    <select id="selectIncorrectProblems" resultType="Problem" parameterType="long" >
        SELECT *
        FROM incorrect_note
        WHERE member_id = #{memberId}
    </select>

    <delete id="deleteIncorrectProblem" parameterType="map">
        DELETE FROM incorrect_note
        WHERE incorrect_note_id = #{incorrectNoteId}
    </delete>


    <insert id="insertIncorrectProblem" parameterType="map">
        INSERT INTO incorrect_note (member_id, problem_id, user_problem_id, problem_type)
        VALUES (#{memberId}, #{problemId}, #{userProblemId}, #{problemType})


    </insert>

</mapper>